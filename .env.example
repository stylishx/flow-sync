# Copy to .env.local and fill in. .env.local is gitignored.

# --- Phase 1: required ---
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=flow-sync

# Doctor-portal cookie signing key. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_SESSION_SECRET=replace-me-with-64-hex-chars-from-the-command-above

# Absolute origin the session QR code points at. Must be the real https origin in
# production or every printed QR code will lead to localhost.
APP_URL=http://localhost:3000

# --- Notifications ---
# "stub" logs instead of sending, so the queue is testable while Meta reviews the
# template. Switching to "meta" REQUIRES the two credentials below or startup fails.
NOTIFY_PROVIDER=stub
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_TEMPLATE_NAME=queue_almost_your_turn
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_API_VERSION=v21.0

# --- Rate limiting (optional) ---
# Set BOTH to share limits across serverless instances. Without them the limiter is
# per-instance and only advisory; the database indexes remain the real guarantee.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Operations ---
# Bearer token for the scheduled /api/cron/reclaim endpoint. If unset the route is
# disabled. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# CRON_SECRET=

# --- Payments ---
# "stub" accepts any payment and REFUSES to run in production.
# "razorpay" is a placeholder that throws until implemented.
PAYMENT_PROVIDER=stub
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
